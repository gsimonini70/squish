@REM ============================================
@REM Squish - Environment Variables (Windows)
@REM ============================================
@REM Copy this file to squish.env.bat and customize

@REM ============================================
@REM Java Configuration
@REM ============================================
@REM set JAVA_HOME=C:\Program Files\Java\jdk-22

@REM ============================================
@REM Compression Settings
@REM ============================================
@REM PRECEDENCE: ACTIVE_PROFILE WINS. COMPRESSION_MODE is the legacy fallback and
@REM is only applied when ACTIVE_PROFILE is empty or names an unknown profile.
@REM Beware: the dashboard and startup log DISPLAY COMPRESSION_MODE even when a
@REM profile is what is really applied. Trust ACTIVE_PROFILE, not the display.
@REM
@REM Named profile (defined under "profiles:" in config\application.yml):
@REM   archival       - LOSSLESS (1.0 scale / 1.0 quality) + PDF/A output
@REM   office         - MEDIUM   (0.75 scale / 0.7 quality)  <- default
@REM   web            - AGGRESSIVE (0.5 scale / 0.3 quality)
@REM   confidential   - MEDIUM + "CONFIDENTIAL" diagonal watermark
@REM   custom-example - explicit 0.7 scale / 0.65 quality
@REM Leave empty (set ACTIVE_PROFILE=) to fall back to COMPRESSION_MODE.
@REM NOTE: do not add trailing comments after a "set" line - cmd would include
@REM them in the value.
set ACTIVE_PROFILE=office

@REM Legacy mode - used only when ACTIVE_PROFILE is empty/unknown.
@REM   LOSSLESS   = 1.0  scale / 1.0 JPEG quality
@REM   MEDIUM     = 0.75 scale / 0.7 JPEG quality
@REM   AGGRESSIVE = 0.5  scale / 0.3 JPEG quality
set COMPRESSION_MODE=AGGRESSIVE
set DRY_RUN=false

@REM ============================================
@REM Pipeline Settings
@REM ============================================
set WORKER_THREADS=16
set ID_FROM=0
set ID_TO=0

@REM ============================================
@REM Database Configuration
@REM ============================================
set DB_URL=jdbc:oracle:thin:@//dbserver:1521/SERVICE
set DB_USER=username
set DB_PASSWORD=password

@REM ============================================
@REM Watchdog Mode
@REM ============================================
set WATCHDOG_ENABLED=true
set WATCHDOG_INTERVAL=300

@REM ============================================
@REM SMTP Email Configuration
@REM ============================================
set EMAIL_ENABLED=true
set SMTP_HOST=smtp.company.com
set SMTP_PORT=587
set SMTP_USER=
set SMTP_PASSWORD=
set SMTP_SSL=false
set SMTP_STARTTLS=true
set SMTP_SSL_PROTOCOLS=TLSv1.2,TLSv1.3
set SMTP_FROM=squish@company.com
set SMTP_TO=it-operations@company.com

@REM ============================================
@REM HTTPS Dashboard Configuration (optional)
@REM ============================================
set HTTP_PORT=8080
set HTTP_SSL_ENABLED=false
@REM set HTTP_KEYSTORE_PATH=C:\squish\config\squish.p12
@REM set HTTP_KEYSTORE_PASSWORD=changeit
@REM set HTTP_KEYSTORE_TYPE=PKCS12
@REM set HTTP_SSL_PROTOCOL=TLSv1.3

@REM ============================================
@REM Dashboard / API Security  (IMPORTANT)
@REM ============================================
@REM HTTP Basic auth protects the WRITE endpoints of the dashboard/API
@REM (POST /api/config, /api/compress, /api/thumbnail). Read-only pages
@REM (dashboard, /api/status, /api/health, /metrics) stay public.
set SECURITY_ENABLED=true
set SECURITY_USERNAME=admin

@REM >>> SET A PASSWORD HERE <<<
@REM If SECURITY_PASSWORD is left empty, Squish generates a RANDOM password at every
@REM restart and only prints it in the log as a WARN line - the password changes on
@REM each restart and the write endpoints are unusable in practice.
@REM This file holds credentials: restrict it to the service account
@REM (Properties > Security, or: icacls squish.env.bat /inheritance:r /grant:r "%USERNAME%":R)
@REM - the equivalent of chmod 600 on Linux.
set SECURITY_PASSWORD=

@REM Browser origins allowed to call the API cross-origin (CORS).
@REM Leave empty to keep CORS disabled - no wildcard is ever sent. Comma-separated:
@REM   set CORS_ALLOWED_ORIGINS=https://app.example.com,https://intranet.example.com
set CORS_ALLOWED_ORIGINS=

@REM ============================================
@REM Java Options
@REM ============================================
set JAVA_OPTS=-Xms512m -Xmx4g -XX:+UseZGC

@REM ============================================
@REM Spring Profile
@REM ============================================
set SPRING_PROFILES_ACTIVE=prod
