#!/bin/sh
### BEGIN INIT INFO
# Provides:          squish
# Required-Start:    $local_fs $network $remote_fs
# Required-Stop:     $local_fs $network $remote_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Squish PDF Compression Engine
# Description:       High-performance PDF compression pipeline
### END INIT INFO

# ============================================
# Squish - SysV Init Script
# ============================================
# For systems without systemd (RHEL/CentOS 6, etc.)
#
# Installation:
#   cp squish.init /etc/init.d/squish
#   chmod +x /etc/init.d/squish
#   chkconfig --add squish      # RHEL/CentOS
#   update-rc.d squish defaults # Debian/Ubuntu
#
# ############################################################################
# # READ THIS: THIS SCRIPT DOES NOT RESTART A CRASHED SQUISH. IT CANNOT.
# ############################################################################
#
# Squish is designed to DIE on an unrecoverable failure rather than linger:
#   - WatchdogService catches a fatal Error (e.g. OutOfMemoryError), logs FATAL,
#     stops the scheduler and calls System.exit(1);
#   - CompressionPipeline throws PipelineFailedException and exits non-zero on a
#     fatal stage failure.
# That is the correct behaviour ONLY IF SOMETHING RESTARTS THE PROCESS. Otherwise
# the previous silent zombie just becomes a silent corpse.
#
# A classic SysV init script is a one-shot launcher: it forks the JVM, writes a
# PID file, and exits. Nothing is left watching. There is no honest way to add
# respawn *inside* this file without shipping a bespoke supervisor daemon, which
# we will not do. So:
#
#   *** systemd (dist/service/squish.service, Restart=on-failure) is the ***
#   *** SUPPORTED deployment. Use it whenever the host has systemd.      ***
#
# If you are stuck on SysV, you MUST supervise Squish with one of these standard
# mechanisms. Pick exactly one:
#
#   (a) cron + the 'check' action of this script (simplest; up to 1 min downtime).
#       Add to root's crontab:
#           * * * * * /etc/init.d/squish check >> /opt/squish/logs/respawn.log 2>&1
#       'check' starts Squish if, and only if, it is not currently running.
#
#   (b) /etc/inittab respawn (true respawn, init itself supervises).
#       Requires a FOREGROUND process - use the launcher directly, not this script:
#           sq:2345:respawn:/bin/su -s /bin/sh squish -c /opt/squish/bin/squish-run.sh
#       then: telinit q
#       Note: with (b) do NOT also chkconfig/update-rc.d this script on, or you
#       will start Squish twice.
#
#   (c) monit / supervisord, e.g. monit:
#           check process squish with pidfile /opt/squish/squish.pid
#             start program = "/etc/init.d/squish start"
#             stop  program = "/etc/init.d/squish stop"
#             if does not exist then restart
#
# 'status' below is honest about the difference between "running", "crashed"
# (dead, PID file left behind) and "not running", using the LSB exit codes
# 0 / 1 / 3 - so cron, monit and a human all get the same answer.
# ############################################################################

NAME=squish
DESC="Squish PDF Compression Engine"
APP_HOME=/opt/squish
LAUNCHER=$APP_HOME/bin/squish-run.sh
PID_FILE=${PID_FILE:-$APP_HOME/squish.pid}
LOG_FILE=$APP_HOME/logs/squish.log
USER=squish

# Source function library (RHEL/CentOS)
if [ -f /etc/rc.d/init.d/functions ]; then
    . /etc/rc.d/init.d/functions
fi

# Source LSB functions (Debian/Ubuntu)
if [ -f /lib/lsb/init-functions ]; then
    . /lib/lsb/init-functions
fi

# Configuration (JAVA_HOME, DB credentials, dashboard password, ...) is loaded
# from $APP_HOME/config/squish.env by bin/squish-run.sh, which runs as $USER and
# passes everything to the JVM through the environment - never on the command
# line, so nothing sensitive shows up in `ps aux`.

# Returns 0 if the PID in $PID_FILE is alive, 1 if the file exists but the
# process is gone (crashed), 3 if there is no PID file at all.
probe() {
    if [ ! -f "$PID_FILE" ]; then
        return 3
    fi
    PID=$(cat "$PID_FILE" 2>/dev/null)
    if [ -z "$PID" ]; then
        return 1
    fi
    if ps -p "$PID" > /dev/null 2>&1; then
        return 0
    fi
    return 1
}

start() {
    probe
    case $? in
        0)
            echo "$NAME is already running (PID: $PID)"
            return 0
            ;;
        1)
            echo "$NAME left a stale PID file ($PID_FILE) - it crashed or was killed. Restarting."
            rm -f "$PID_FILE"
            ;;
    esac

    if [ ! -x "$LAUNCHER" ]; then
        echo "ERROR: launcher not found or not executable: $LAUNCHER"
        return 1
    fi

    echo "Starting $DESC..."

    # Runtime directories. 'reports' is squish.report.directory, relative to
    # APP_HOME - if it does not exist and is not writable by $USER, every PDF
    # report write fails at the end of a run.
    mkdir -p "$APP_HOME/logs" "$APP_HOME/reports"
    if [ -n "$USER" ]; then
        chown "$USER:$USER" "$APP_HOME/logs" "$APP_HOME/reports" 2>/dev/null
    fi

    # squish-run.sh exec()s the JVM, so $! is the PID of the JVM itself.
    if [ -n "$USER" ]; then
        su -s /bin/sh "$USER" -c "nohup $LAUNCHER >> $LOG_FILE 2>&1 & echo \$! > $PID_FILE"
    else
        nohup "$LAUNCHER" >> "$LOG_FILE" 2>&1 &
        echo $! > "$PID_FILE"
    fi

    sleep 3

    if probe; then
        echo "$NAME started (PID: $PID)"
        return 0
    fi

    echo "ERROR: Failed to start $NAME - see $LOG_FILE"
    rm -f "$PID_FILE"
    return 1
}

stop() {
    probe
    case $? in
        3)
            echo "$NAME is not running"
            return 0
            ;;
        1)
            echo "$NAME is not running (stale PID file removed)"
            rm -f "$PID_FILE"
            return 0
            ;;
    esac

    echo "Stopping $DESC (PID: $PID)..."
    kill "$PID"

    COUNT=0
    while [ $COUNT -lt 60 ]; do
        if ! ps -p "$PID" > /dev/null 2>&1; then
            break
        fi
        sleep 1
        COUNT=$((COUNT + 1))
    done

    if ps -p "$PID" > /dev/null 2>&1; then
        echo "Force killing..."
        kill -9 "$PID"
    fi

    rm -f "$PID_FILE"
    echo "$NAME stopped"
}

# LSB exit codes:
#   0 - running
#   1 - dead, but PID file exists  (i.e. IT CRASHED: exit(1) on a fatal Error,
#       a failed pipeline stage, or an external kill -9)
#   3 - not running
status() {
    probe
    case $? in
        0)
            echo "$NAME is running (PID: $PID)"
            return 0
            ;;
        1)
            echo "$NAME is DEAD but $PID_FILE exists - the process crashed and"
            echo "  nothing restarted it. Check $LOG_FILE for 'FATAL' and see the"
            echo "  supervision notes at the top of this script."
            return 1
            ;;
        *)
            echo "$NAME is not running"
            return 3
            ;;
    esac
}

# For cron-based supervision on SysV hosts (option (a) at the top of this file).
# Starts Squish only if it is not currently running; silent when it is, so it
# does not spam a mailbox every minute.
check() {
    probe
    case $? in
        0)
            return 0
            ;;
        1)
            echo "[$(date '+%Y-%m-%d %H:%M:%S')] $NAME is dead (stale PID file) - restarting"
            ;;
        *)
            echo "[$(date '+%Y-%m-%d %H:%M:%S')] $NAME is not running - starting"
            ;;
    esac
    start
}

case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart|reload|force-reload)
        stop
        sleep 2
        start
        ;;
    status)
        status
        ;;
    check|restart-if-dead)
        check
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status|check}"
        echo "  check - start only if not running (for cron-based supervision)"
        exit 1
        ;;
esac

exit $?
