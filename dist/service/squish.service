# ============================================
# Squish - Systemd Service File
# ============================================
# Installation:
#   1. Copy to /etc/systemd/system/squish.service
#   2. sudo systemctl daemon-reload
#   3. sudo systemctl enable squish
#   4. sudo systemctl start squish
#
# systemd is the SUPPORTED supervision path for Squish. The app deliberately
# exits non-zero when it cannot continue (WatchdogService on a fatal Error such
# as OutOfMemoryError, CompressionPipeline on a fatal stage failure) instead of
# lingering as a zombie that answers the dashboard but processes nothing. The
# recovery for that is Restart=on-failure below. Do not remove it.

[Unit]
Description=Squish PDF Compression Engine
Documentation=https://github.com/gsimonini70/squish
After=network-online.target
Wants=network-online.target

# Give up (and stay 'failed', loudly) instead of hot-looping forever if the
# process dies immediately on every start - e.g. bad DB credentials.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=squish
Group=squish
WorkingDirectory=/opt/squish

# NOTE: we do NOT use EnvironmentFile= here.
# /opt/squish/config/squish.env is a *shell* file: its lines carry `export` and
# trailing `# comments`, neither of which systemd's EnvironmentFile= parser
# understands (it would silently drop every variable). bin/squish-run.sh sources
# it with a real shell and then exec()s the JVM, so the JVM inherits the config
# through its environment - and credentials still never appear in `ps aux`.
#
# ExecStart must also be an absolute path: systemd does NOT expand variables in
# the first token, so the old `ExecStart=${JAVA_HOME}/bin/java ...` never worked.
ExecStart=/opt/squish/bin/squish-run.sh

KillSignal=SIGTERM
TimeoutStopSec=90

# Restart configuration - see the note at the top of this file.
Restart=on-failure
RestartSec=10

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

# ProtectSystem=strict makes the WHOLE filesystem read-only except what is listed
# here. The app writes in two places under WorkingDirectory:
#   logs/     - logback (logging.file.name)
#   reports/  - squish.report.directory, default 'reports', RELATIVE to
#               WorkingDirectory. If you point REPORT_DIRECTORY somewhere else,
#               that path must be added here too or every report write will fail.
ReadWritePaths=/opt/squish/logs
ReadWritePaths=/opt/squish/reports

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=squish

[Install]
WantedBy=multi-user.target
